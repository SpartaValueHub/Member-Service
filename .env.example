# Member Service 환경변수
#
# [로컬 최초 설정]
# 1. cp .env.example .env
# 2. .env 에 DB 비밀번호 등 실제 값 입력
#
# DB — auth-service 와 동일 MySQL 인스턴스, 스키마만 member_db
SPRING_DATASOURCE_URL=jdbc:mysql://192.168.10.45:3307/member_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your-password-here

# 선택 — 기본 local (application.yml)
# SPRING_PROFILES_ACTIVE=local

# dev / prod (Docker·배포)
# SPRING_PROFILES_ACTIVE=dev
# EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://discovery:8761/eureka
